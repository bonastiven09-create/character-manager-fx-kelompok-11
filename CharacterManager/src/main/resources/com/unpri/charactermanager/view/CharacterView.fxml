<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.unpri.charactermanager.view.CharacterController"
            style="-fx-background-color: #eef2f7;">
    <top>
        <VBox spacing="8">
            <padding><Insets top="16" right="20" bottom="12" left="20"/></padding>
            <Label text="Character Manager"
                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1f2937;"/>
            <Label text="Kelola karakter dari form berikut" style="-fx-text-fill: #6b7280;"/>
            <Separator/>
        </VBox>
    </top>

    <left>
        <VBox spacing="10" prefWidth="280" style="-fx-background-color: white; -fx-border-color: #d5d8dc;">
            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
            <Label text="Data Karakter" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

            <Label text="Nama"/>
            <TextField fx:id="nameField" promptText="Masukkan nama karakter" onAction="#handleSave"/>

            <Label text="Tipe"/>
            <ComboBox fx:id="typeCombo" maxWidth="Infinity" promptText="Pilih tipe"/>

            <Label text="Level"/>
            <Spinner fx:id="levelSpinner" editable="true" maxWidth="Infinity"/>

            <Label fx:id="messageLabel" wrapText="true" minHeight="45"
                   style="-fx-text-fill: #b91c1c;"/>

            <HBox spacing="8">
                <Button text="Simpan" onAction="#handleSave" defaultButton="true" HBox.hgrow="ALWAYS"
                        style="-fx-background-color: #2563eb; -fx-text-fill: white;"/>
                <Button text="Reset" onAction="#handleReset" HBox.hgrow="ALWAYS"/>
            </HBox>
        </VBox>
    </left>

    <center>
        <VBox spacing="10">
            <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>
            <HBox spacing="16">
                <Label fx:id="countLabel" text="Jumlah: 0"
                       style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                <Label fx:id="avgLevelLabel" text="Rata-rata level: 0.00"
                       style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
            </HBox>

            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background: #f8fafc; -fx-background-color: #f8fafc;">
                <VBox fx:id="cardsBox" spacing="8">
                    <padding><Insets top="8" right="8" bottom="8" left="8"/></padding>
                </VBox>
            </ScrollPane>
        </VBox>
    </center>

    <bottom>
        <HBox style="-fx-background-color: #1f2937;">
            <padding><Insets top="10" right="20" bottom="10" left="20"/></padding>
            <Label fx:id="statusLabel" text="Siap" textFill="white"/>
        </HBox>
    </bottom>
</BorderPane>
